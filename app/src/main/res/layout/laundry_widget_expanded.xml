<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_brand" android:textColor="@color/widget_text_secondary" android:textSize="12sp"
            android:maxLines="1" android:importantForAccessibility="no" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary" android:textSize="12sp" android:contentDescription="@string/widget_current_time" />
    </LinearLayout>
    <TextView android:id="@+id/widget_building" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/widget_text_primary" android:textSize="21sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_board" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false"
                android:textColor="@color/widget_accent" android:textSize="46sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="46sp"
                android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_primary_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="0dp">
            <TextView android:id="@+id/widget_busy" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary" android:textSize="23sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_usage_label"
                android:textColor="@color/widget_text_secondary" android:textSize="12sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_unknown" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/widget_text_primary" android:textSize="23sp"
                android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_unknown_label"
                android:textColor="@color/widget_text_secondary" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_section" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:padding="14dp" android:orientation="vertical" android:background="@drawable/widget_panel">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_my_laundry"
            android:textColor="@color/widget_text_secondary" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textColor="@color/widget_text_primary" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_eta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/widget_text_primary" android:textSize="14sp"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_note" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/widget_expected_disclaimer" android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <TextView android:id="@+id/widget_board_action" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
            android:text="@string/widget_building_overview" android:textColor="@color/widget_accent" android:textSize="13sp" />
        <TextView android:id="@+id/widget_task_action" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical|end"
            android:text="@string/widget_my_laundry" android:textColor="@color/widget_accent" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
