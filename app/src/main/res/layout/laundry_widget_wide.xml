<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_building" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/widget_text_secondary" android:textSize="12sp"
            android:contentDescription="@string/widget_current_time" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_board" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false"
                android:textColor="@color/widget_accent" android:textSize="36sp" android:textStyle="bold"
                android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="15sp"
                android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_primary_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/widget_text_secondary" android:textSize="11sp"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_task_section" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="match_parent" android:layout_marginStart="12dp" android:padding="10dp"
            android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_my_laundry"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="@color/widget_text_primary" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task_eta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="@color/widget_text_primary" android:textSize="12sp"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/widget_text_secondary" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
