    android:id="@+id/widget_water_active"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="700"
    android:animateFirstView="false"
    android:importantForAccessibility="no">
    <ImageView android:id="@+id/widget_water_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_water_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_water_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
</ViewFlipper>
